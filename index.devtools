}@keyframes motion-breathe-1 {
  0% { animation-timing-function: cubic-bezier(0.39, 0.575, 0.565, 1); transform: var(--motion-breathe-perspective, ) translate3d(0, 0, 0) rotateZ(var(--comp-rotate-z, 0deg)); }
